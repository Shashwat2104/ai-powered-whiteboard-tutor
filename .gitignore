/.playwright-mcp/

# documentation and markdown (only README.md ships for deployment)
doc/
/doc/
docs/
/docs/
documentation/
/documentation/
*doc*/
*.doc
*.docx
*.md
!README.md

# test and tool output
/playwright-report/
/test-results/
/blob-report/
/.vitest-cache/
/scripts/eval-topics.json

# editors and OS
.vscode/
.idea/
Thumbs.db
*.log
/scratch/
