# --- LLM providers (at least one required) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT_LESSON=medium
ANTHROPIC_EFFORT_FOLLOWUP=low
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-model-id-pinned-at-scaffold
LLM_PROVIDER_ORDER=anthropic,gemini

# --- Text-to-speech providers (at least one recommended) ---
# Free ElevenLabs plan: premade voices only (George below), 2 concurrent requests, small monthly credit quota.
# The SDK key may also live in .env; Next.js loads .env and .env.local.
ELEVENLABS_API_KEY=your-elevenlabs-key-here
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_CONCURRENCY=2
# API key restricted to the Cloud Text-to-Speech API only.
GOOGLE_TTS_API_KEY=your-google-tts-key-here
GOOGLE_TTS_VOICE=en-US-Neural2-D
TTS_PROVIDER_ORDER=elevenlabs,google

# --- Security ---
# At least 32 random bytes, base64url. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NARRATION_TOKEN_SECRET=replace-with-32-plus-random-bytes
RATE_LIMIT_LESSON_PER_10MIN=5
RATE_LIMIT_NARRATION_PER_10MIN=60
RATE_LIMIT_FOLLOWUP_PER_10MIN=30
DAILY_LESSON_CAP=200

# --- Testing / deployment flags (never set TUTOR_TEST_PROVIDERS on a deployment) ---
# TUTOR_TEST_PROVIDERS=1
# TUTOR_DEPLOYED=1
